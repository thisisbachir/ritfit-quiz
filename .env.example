# Local development (shopify app dev sets the SHOPIFY_* values for you)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ritfit_quiz"

# Klaviyo private API key — scopes: Events, Profiles, Lists, Subscriptions (write)
KLAVIYO_PRIVATE_API_KEY=""

# Set on Railway (values from the Partner Dashboard → your app → Client credentials)
# SHOPIFY_API_KEY=""
# SHOPIFY_API_SECRET=""
# SHOPIFY_APP_URL="https://<your-service>.up.railway.app"
# SCOPES="read_products,read_orders"
# PORT=3000
